{
  "name": "lumicache",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run typecheck && bun build src/backend.ts --outfile dist/backend.js --target bun && bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "test:host": "bun scripts/test-host.ts",
    "package": "bun scripts/package.ts",
    "deploy": "powershell.exe -NoProfile -File scripts/deploy.ps1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "fflate": "0.8.3",
    "happy-dom": "^21.0.4",
    "lumiverse-spindle-types": "0.6.59",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
